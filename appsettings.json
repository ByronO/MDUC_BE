{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sonar": {
    "GraphQLUrl": "https://<host>/graphql",
    "ApiKey": "SONAR_API_KEY_PLACEHOLDER"
  },
  "PublicApiKey": "PUBLIC_API_KEY_PLACEHOLDER",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000"
    ]
  }
}
